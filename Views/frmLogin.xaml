<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPET_2._0.Views.frmLogin"
             Title="Login"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15"
            VerticalOptions="Center">

            <Image Source="logo.jpeg"
                   HeightRequest="130"
                   WidthRequest="130"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,20,0,5"/>

            <Label Text="VanderPET"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"/>

            <Label Text="Entre para acessar sua conta"
                   FontSize="15"
                   TextColor="#777777"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Label Text="Email"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtEmail"
                       Placeholder="Digite seu email"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="Senha"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   Margin="0,5,0,0"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtSenha"
                       Placeholder="Digite sua senha"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label x:Name="lblErro"
                   Text=""
                   FontSize="13"
                   TextColor="Red"
                   IsVisible="False"/>

            <Button Text="ENTRAR"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,0"
                    Clicked="btnLogin_Clicked"/>

            <Grid ColumnDefinitions="*,*"
                  Margin="0,10,0,0">
                <Label Text="Esqueceu sua senha?"
                       Grid.Column="0"
                       FontSize="14"
                       TextColor="#4F46E5"
                       HorizontalOptions="Start">
                       <Label.GestureRecognizers>  
                           <TapGestureRecognizer Tapped="lblRecuperarSenha_Tapped"/>
                       </Label.GestureRecognizers>
                </Label>
                <Label Text="Cadastre-se"
                       Grid.Column="1"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#4F46E5"
                       HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="lblCadastro_Tapped"/>
                        </Label.GestureRecognizers>
                </Label>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>