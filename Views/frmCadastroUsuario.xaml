<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPET_2._0.Views.frmCadastroUsuario"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12">

            <Label Text="Criar Conta"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,5"/>

            <Label Text="Preencha seus dados para se cadastrar"
                   FontSize="14"
                   TextColor="#777777"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,15"/>

            <Label Text="Nome"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>

            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtNome"
                       Placeholder="Digite seu nome"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="Email"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtEmail"
                       Placeholder="Digite seu email"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="CPF"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtCPF"
                       Placeholder="000.000.000-00"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       Keyboard="Numeric"
                       MaxLength="14"
                       TextChanged="txtCPF_TextChanged"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="Telefone"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtTelefone"
                       Placeholder="(00) 00000-0000"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       Keyboard="Numeric"
                       MaxLength="15"
                       TextChanged="txtTelefone_TextChanged"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="CEP"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtCEP"
                       Placeholder="00000-000"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       Keyboard="Numeric"
                       MaxLength="9"
                       TextChanged="txtCEP_TextChanged"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="Endereço"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtEndereco"
                       Placeholder="Digite seu endereço"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="Senha"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtSenha"
                       Placeholder="Digite sua senha"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label Text="Confirmar Senha"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtConfirmarSenha"
                       Placeholder="Digite novamente sua senha"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label x:Name="lblErro"
                   Text=""
                   FontSize="13"
                   TextColor="Red"
                   IsVisible="False"/>

            <Button Text="CADASTRAR"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,0"
                    Clicked="btnCadastrar_Clicked"/>

            <Label Text="Voltar ao Login"
                   FontSize="14"
                   TextColor="#4F46E5"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,25">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="lblVoltar_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>