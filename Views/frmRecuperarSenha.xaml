<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPET_2._0.Views.frmRecuperarSenha"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15"
            VerticalOptions="Center">

            <Label Text="Recuperar Senha"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,5"/>

            <Label Text="Informe o email cadastrado para recuperar sua senha"
                   FontSize="14"
                   TextColor="#777777"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <Label Text="Email"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtEmail"
                       Placeholder="Digite seu email"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#333333"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       Margin="10,0"/>
            </Border>

            <Label x:Name="lblErro"
                   Text=""
                   FontSize="13"
                   TextColor="Red"
                   IsVisible="False"/>

            <Button Text="RECUPERAR SENHA"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,0"
                    Clicked="btnRecuperar_Clicked"/>
               
            <Label Text="Voltar ao Login"
                   FontSize="14"
                   TextColor="#4F46E5"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,20">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="lblVoltar_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>