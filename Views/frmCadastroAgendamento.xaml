<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderPET_2._0.Views.frmCadastroAgendamento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Novo Agendamento"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,10"/>

            <Label Text="PET"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <Border Grid.Column="0"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="50">
                    <Picker x:Name="pckPet"
                            Title="Selecione o PET"
                            TitleColor="#AAAAAA"
                            TextColor="#333333"
                            BackgroundColor="Transparent"
                            Margin="10,0"
                            ItemDisplayBinding="{Binding Nome}"/>
                </Border>
                <Button Grid.Column="1"
                        Text="VER PETS"
                        HeightRequest="50"
                        FontSize="12"
                        FontAttributes="Bold"
                        BackgroundColor="#E5E7EB"
                        TextColor="#333333"
                        CornerRadius="10"
                        Clicked="btnVerPets_Clicked"/>

            </Grid>

            <Label Text="Porte"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Picker x:Name="pckPorte"
                        Title="Selecione o porte"
                        TitleColor="#AAAAAA"
                        TextColor="#333333"
                        BackgroundColor="Transparent"
                        Margin="10,0"
                        SelectedIndexChanged="pckPorte_SelectedIndexChanged"/>
            </Border>

            <Label Text="Serviço"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Picker x:Name="pckServico"
                        Title="Selecione o serviço"
                        TitleColor="#AAAAAA"
                        TextColor="#333333"
                        BackgroundColor="Transparent"
                        Margin="10,0"
                        IsEnabled="False"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedIndexChanged="pckServico_SelectedIndexChanged"/>
            </Border>

            <Label Text="Valor"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="#EEEEEE"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry x:Name="txtValor"
                       Placeholder="Selecione um serviço"
                       PlaceholderColor="#888888"
                       TextColor="#333333"
                       BackgroundColor="Transparent"
                       IsReadOnly="True"
                       Margin="10,0"/>
            </Border>

            <Label Text="Data"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <DatePicker x:Name="dtpData"
                            Format="dd/MM/yyyy"
                            TextColor="#333333"
                            BackgroundColor="Transparent"
                            Margin="10,0"/>
            </Border>

            <Label Text="Horário"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <TimePicker x:Name="tmpHorario"
                            Format="HH:mm"
                            TextColor="#333333"
                            BackgroundColor="Transparent"
                            Margin="10,0"/>
            </Border>

            <Label Text="Horário de funcionamento: 08:00 às 18:00"
                   FontSize="12"
                   TextColor="#777777"/>

            <Label Text="Observações"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <Border Stroke="#DDDDDD"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    Padding="5">
                <Editor x:Name="txtObservacoes"
                        Placeholder="Observações sobre o atendimento"
                        PlaceholderColor="#AAAAAA"
                        TextColor="#333333"
                        BackgroundColor="Transparent"
                        HeightRequest="90"
                        AutoSize="TextChanges"/>
            </Border>

            <Label x:Name="lblErro"
                   Text=""
                   FontSize="13"
                   TextColor="Red"
                   IsVisible="False"/>

            <Button Text="AGENDAR"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,0"
                    Clicked="btnAgendar_Clicked"/>

            <Button Text="VOLTAR"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#E5E7EB"
                    TextColor="#333333"
                    CornerRadius="10"
                    Clicked="btnVoltar_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>